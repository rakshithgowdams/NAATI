# =============================================================================
# NAATI ORGANICS — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development or configure these
# environment variables in your deployment platform (Vercel, Netlify, Docker, etc.)

# Public Website Canonical URL (used for metadata, open graph images, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.naatiorganics.com

# Webhook Endpoints for Automated Inquiries (Slack / Discord / WhatsApp / CRM)
# If left empty, submissions are logged cleanly to server console with unique reference IDs.
CONTACT_WEBHOOK_URL=
DEALER_ENQUIRY_WEBHOOK_URL=

# Optional Notification Email configuration
CONTACT_NOTIFICATION_EMAIL=info@naatiorganics.com
DEALER_NOTIFICATION_EMAIL=partners@naatiorganics.com
